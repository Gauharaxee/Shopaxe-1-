{
  "entities": {
    "products": {
      "title": "products",
      "description": "Storefront product catalog items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "image": { "type": "string" },
        "secondaryImage": { "type": "string" },
        "description": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "sku": { "type": "string" },
        "isNew": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "hex": { "type": "string" }
            }
          }
        },
        "sizes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "details": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "category", "price", "image", "inStock", "stockCount"]
    },
    "orders": {
      "title": "orders",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentGateway": { "type": "string" },
        "paymentDetails": { "type": "object" },
        "currency": { "type": "string" },
        "amountPkr": { "type": "number" },
        "date": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "trackingNumber": { "type": "string" }
      },
      "required": ["customerName", "customerEmail", "items", "total", "status", "date"]
    },
    "security_logs": {
      "title": "security_logs",
      "description": "System security and administrative audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "ipAddress": { "type": "string" },
        "user": { "type": "string" }
      },
      "required": ["timestamp", "action", "category", "severity"]
    },
    "customers": {
      "title": "customers",
      "description": "Store customer profiles and lifetime order statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "status": { "type": "string" },
        "lastOrderDate": { "type": "string" }
      },
      "required": ["name", "email", "totalOrders", "totalSpent"]
    },
    "tickets": {
      "title": "tickets",
      "description": "Customer support tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["customerName", "customerEmail", "subject", "message", "status"]
    },
    "reviews": {
      "title": "reviews",
      "description": "Customer star ratings and written reviews for storefront products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "author": { "type": "string" },
        "rating": { "type": "number" },
        "date": { "type": "string" },
        "comment": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" }
      },
      "required": ["productId", "author", "rating", "comment"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Product items catalog"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Customer orders"
    },
    "/security_logs/{logId}": {
      "schema": "security_logs",
      "description": "Audit security events"
    },
    "/customers/{customerId}": {
      "schema": "customers",
      "description": "Customer accounts"
    },
    "/tickets/{ticketId}": {
      "schema": "tickets",
      "description": "Support tickets"
    },
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Product reviews"
    }
  }
}
