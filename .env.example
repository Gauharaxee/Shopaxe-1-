# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUST WALLET BACKEND CONFIGURATION
# Merchant receiving wallet addresses & network routing kept securely on the backend
TRUST_WALLET_ADDRESS="0x4EdF2D77584109B1071a6eE1D77638a2f6Cc983e"
TRUST_WALLET_USDT_BEP20_ADDRESS="0x4EdF2D77584109B1071a6eE1D77638a2f6Cc983e"
TRUST_WALLET_USDT_TRC20_ADDRESS="TN3W4H6rK2ce4vX9YnFQHwKENFEeTRC20TWS"
TRUST_WALLET_USDT_POLYGON_ADDRESS="0x4EdF2D77584109B1071a6eE1D77638a2f6Cc983e"
TRUST_WALLET_MERCHANT_NAME="AXE SHOP OFFICIAL / TRUST WALLET"
TRUST_WALLET_DEFAULT_NETWORK="USDT (BEP-20)"
TRUST_WALLET_ENV="live"

# SMS 2FA GATEWAY CONFIGURATION (Optional - for cellular carrier dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEXTBELT_KEY=
SMS_GATEWAY_URL=
